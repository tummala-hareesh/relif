{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "installCommand": "echo 'frontend/build.py is stdlib-only: nothing to install'",
  "buildCommand": "python3 frontend/build.py --out frontend/site",
  "outputDirectory": "frontend/site",
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        { "key": "Referrer-Policy", "value": "no-referrer" },
        { "key": "X-Content-Type-Options", "value": "nosniff" }
      ]
    }
  ]
}
