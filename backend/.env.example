# Copy to .env (gitignored) and fill in. Never commit the real .env.
# Store folder on the laptop (default ~/.relif) and your uid/gid so its files stay yours: `id -u`, `id -g`.
RELIF_HOME=~/.relif
RELIF_UID=1000
RELIF_GID=1000
# Tailscale sidecar only (compose.tailscale.yaml): a tagged, non-reusable, pre-approved auth key from
# https://login.tailscale.com/admin/settings/keys, and the node's https address.
TS_AUTHKEY=
RELIF_PUBLIC_URL=https://relif.<your-tailnet>.ts.net
